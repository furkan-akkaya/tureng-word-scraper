{
  "manifest_version": 3,
  "name": "Tureng Kelime Toplayıcı",
  "version": "1.0.0",
  "description": "Tureng.com'da arattığınız kelimeleri otomatik olarak kaydeder ve CSV olarak dışa aktarır.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "*://tureng.com/*",
    "*://www.tureng.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://tureng.com/*",
        "*://www.tureng.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
